# Server environment variables
# Copy this file to .env and fill in your values
# Never commit the real .env file to git!

# MongoDB Atlas connection string
# Get this from MongoDB Atlas: Connect > Drivers > Node.js
MONGODB_URL=mongodb+srv://backnd_db:Walid0099@cluster0.zgfv8hg.mongodb.net/?appName=Cluster0

# JWT secret for authentication tokens
# Use a long random string in production
JWT_SECRET=your-secret-key-change-this

# Admin account credentials (created on first server start)
ADMIN_EMAIL=admin@solarsystem.pk
ADMIN_PASSWORD=admin12345

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Server port
PORT=5000
